# 5. Corrected PDF split design

The current split methods are tightly coupled to the GUI. They should be moved into a separate service.

## `bike_map_atlas/pdf_splitter.py`

```python
from __future__ import annotations

import os
from pathlib import Path

from .map_renderer import MapRenderer
from .models import MapSection
from .pdf_tools import merge_pdfs


class PDFSplitter:
    def __init__(
        self,
        output_path: str | Path,
        renderer: MapRenderer,
    ) -> None:
        self.output_path = Path(output_path)
        self.renderer = renderer

    def split_by_km(
        self,
        overview_pdf: Path,
        section_pdfs: list[Path],
        sections: list[MapSection],
        km_per_file: float,
    ) -> list[Path]:
        groups: list[list[int]] = []
        current: list[int] = []
        current_km = 0.0

        for index, section in enumerate(sections):
            section_km = (
                section.end_m - section.start_m
            ) / 1000.0

            current.append(index)
            current_km += section_km

            if current_km >= km_per_file:
                groups.append(current)
                current = []
                current_km = 0.0

        if current:
            groups.append(current)

        return self._write_groups(
            groups,
            overview_pdf,
            section_pdfs,
            sections,
        )

    def split_by_size(
        self,
        overview_pdf: Path,
        section_pdfs: list[Path],
        sections: list[MapSection],
        max_mb: float,
    ) -> list[Path]:
        groups: list[list[int]] = []
        current: list[int] = []
        current_size = 0.0

        for index, section_pdf in enumerate(section_pdfs):
            size_mb = (
                os.path.getsize(section_pdf)
                / (1024.0 * 1024.0)
            )

            if current and current_size + size_mb > max_mb:
                groups.append(current)
                current = []
                current_size = 0.0

            current.append(index)
            current_size += size_mb

        if current:
            groups.append(current)

        return self._write_groups(
            groups,
            overview_pdf,
            section_pdfs,
            sections,
        )

    def _write_groups(
        self,
        groups: list[list[int]],
        overview_pdf: Path,
        section_pdfs: list[Path],
        sections: list[MapSection],
    ) -> list[Path]:
        outputs: list[Path] = []
        base = self.output_path.stem
        directory = self.output_path.parent

        for group_number, group in enumerate(groups, start=1):
            part_output = directory / (
                f"{base}_part{group_number}.pdf"
            )

            inputs: list[Path] = []

            if group_number == 1:
                inputs.append(overview_pdf)

            part_sections = [
                sections[index]
                for index in group
            ]

            part_overview = directory / (
                f".{base}_part{group_number}_overview.pdf"
            )

            total_km = sum(
                (
                    section.end_m - section.start_m
                ) / 1000.0
                for section in part_sections
            )

            self.renderer.render_overview(
                part_sections,
                total_km,
                part_overview,
            )

            inputs.append(part_overview)
            inputs.extend(
                section_pdfs[index]
                for index in group
            )

            merge_pdfs(inputs, part_output)
            part_overview.unlink(missing_ok=True)

            outputs.append(part_output)

        return outputs
```

The PDF splitter now has no dependency on Tkinter and can be tested independently.

