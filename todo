## `bike_map_atlas/draggable.py`

```python
from __future__ import annotations


class DraggableRectangle:
    def __init__(
        self,
        rectangle,
        section_idx: int,
        on_double_click,
        on_drag_end,
    ) -> None:
        self.rectangle = rectangle
        self.section_idx = section_idx
        self.on_double_click = on_double_click
        self.on_drag_end = on_drag_end

        self.press_position = None
        self.dragging = False
        self.click_timer = None

        canvas = rectangle.figure.canvas
        canvas.mpl_connect(
            "button_press_event",
            self.on_press,
        )
        canvas.mpl_connect(
            "button_release_event",
            self.on_release,
        )
        canvas.mpl_connect(
            "motion_notify_event",
            self.on_motion,
        )

    def on_press(self, event) -> None:
        if event.inaxes != self.rectangle.axes:
            return

        contains, _ = self.rectangle.contains(event)

        if not contains:
            return

        self.press_position = (
            event.xdata,
            event.ydata,
        )
        self.dragging = False

        if self.click_timer is None:
            self.click_timer = (
                self.rectangle.figure.canvas.new_timer(
                    interval=300,
                )
            )
            self.click_timer.single_shot = True
            self.click_timer.add_callback(
                self._clear_click_timer,
            )
            self.click_timer.start()
        else:
            self.click_timer.stop()
            self.click_timer = None
            self.on_double_click(self.section_idx)

    def _clear_click_timer(self) -> None:
        self.click_timer = None

    def on_motion(self, event) -> None:
        if self.press_position is None:
            return

        if event.inaxes != self.rectangle.axes:
            return

        if event.xdata is None or event.ydata is None:
            return

        old_x, old_y = self.press_position
        dx = event.xdata - old_x
        dy = event.ydata - old_y

        if abs(dx) > 0.005 or abs(dy) > 0.005:
            self.dragging = True

            x, y = self.rectangle.xy
            self.rectangle.set_xy((x + dx, y + dy))

            self.press_position = (
                event.xdata,
                event.ydata,
            )

            self.rectangle.figure.canvas.draw_idle()

    def on_release(self, event) -> None:
        if self.press_position is None:
            return

        if self.dragging:
            x, y = self.rectangle.xy
            width = self.rectangle.get_width()
            height = self.rectangle.get_height()

            center_x = x + width / 2.0
            center_y = y + height / 2.0

            self.on_drag_end(
                self.section_idx,
                center_x,
                center_y,
            )

        self.press_position = None
        self.dragging = False
```

This version keeps the rectangle in the same projected coordinate system as the renderer. It no longer converts the drag location through an inaccurate local UTM approximation.

