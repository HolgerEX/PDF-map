## `bike_map_atlas/dialogs.py`

```python
from __future__ import annotations

import tkinter as tk
from tkinter import messagebox


class SectionSettingsDialog:
    def __init__(
        self,
        parent: tk.Misc,
        section_idx: int,
        current_scale: int,
        current_zoom: int | None,
        callback,
    ) -> None:
        self.section_idx = section_idx
        self.callback = callback

        self.dialog = tk.Toplevel(parent)
        self.dialog.title(
            f"Section {section_idx + 1} Settings"
        )
        self.dialog.geometry("320x220")
        self.dialog.transient(parent)
        self.dialog.resizable(False, False)

        tk.Label(
            self.dialog,
            text="Map scale denominator:",
        ).pack(pady=5)

        self.scale_var = tk.StringVar(
            value=str(current_scale)
        )

        tk.Entry(
            self.dialog,
            textvariable=self.scale_var,
            width=15,
        ).pack()

        tk.Label(
            self.dialog,
            text="Tile zoom, 0-20; empty means automatic:",
        ).pack(pady=5)

        self.zoom_var = tk.StringVar(
            value=(
                str(current_zoom)
                if current_zoom is not None
                else ""
            )
        )

        tk.Entry(
            self.dialog,
            textvariable=self.zoom_var,
            width=10,
        ).pack()

        buttons = tk.Frame(self.dialog)
        buttons.pack(pady=15)

        tk.Button(
            buttons,
            text="Apply",
            command=self._apply,
        ).pack(side=tk.LEFT, padx=5)

        tk.Button(
            buttons,
            text="Cancel",
            command=self.dialog.destroy,
        ).pack(side=tk.LEFT)

        self.dialog.after(10, self._grab)

    def _grab(self) -> None:
        self.dialog.grab_set()
        self.dialog.focus_set()

    def _apply(self) -> None:
        try:
            scale = int(self.scale_var.get())

            if scale <= 0:
                raise ValueError

        except ValueError:
            messagebox.showerror(
                "Invalid scale",
                "Scale must be a positive integer.",
            )
            return

        zoom_text = self.zoom_var.get().strip()
        zoom: int | None = None

        if zoom_text:
            try:
                zoom = int(zoom_text)

                if not 0 <= zoom <= 20:
                    raise ValueError

            except ValueError:
                messagebox.showerror(
                    "Invalid zoom",
                    "Zoom must be an integer from 0 to 20.",
                )
                return

        self.callback(
            self.section_idx,
            scale,
            zoom,
        )

        self.dialog.destroy()
```

