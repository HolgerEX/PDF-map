## `bike_map_atlas/models.py`

```python
from __future__ import annotations

from dataclasses import dataclass
from typing import Optional


@dataclass(slots=True)
class RoutePoint:
    lat: float
    lon: float
    x: float
    y: float
    distance_m: float = 0.0
    zone: Optional[int] = None


@dataclass
class MapSection:
    index: int
    points: list[RoutePoint]
    start_m: float
    end_m: float
    center_xy: tuple[float, float]
    orientation: str
    paper_size: str
    global_scale: int
    custom_scale: Optional[int] = None
    custom_center_xy: Optional[tuple[float, float]] = None
    custom_zoom: Optional[int] = None

    @property
    def effective_scale(self) -> int:
        return (
            self.custom_scale
            if self.custom_scale is not None
            else self.global_scale
        )

    @property
    def effective_center_xy(self) -> tuple[float, float]:
        return (
            self.custom_center_xy
            if self.custom_center_xy is not None
            else self.center_xy
        )

    @property
    def effective_zoom(self) -> int:
        if self.custom_zoom is not None:
            return self.custom_zoom

        scale = self.effective_scale

        if scale <= 5_000:
            return 18
        if scale <= 10_000:
            return 17
        if scale <= 25_000:
            return 16
        if scale <= 50_000:
            return 15
        if scale <= 100_000:
            return 14
        return 12

    def set_custom_center(self, x: float, y: float) -> None:
        self.custom_center_xy = (x, y)
```

---

## `bike_map_atlas/projection.py`

This version uses `pyproj`, which should be added to the dependencies.

```python
from __future__ import annotations

import math
from functools import lru_cache

from pyproj import Transformer


WEB_MERCATOR = "EPSG:3857"
WGS84 = "EPSG:4326"


def utm_zone_for_longitude(lon: float) -> int:
    return min(60, max(1, int((lon + 180.0) / 6.0) + 1))


def utm_epsg(lat: float, lon: float) -> int:
    zone = utm_zone_for_longitude(lon)
    return 32600 + zone if lat >= 0 else 32700 + zone


@lru_cache(maxsize=120)
def _transformer(source: str, target: str) -> Transformer:
    return Transformer.from_crs(
        source,
        target,
        always_xy=True,
    )


def latlon_to_projected(
    lat: float,
    lon: float,
) -> tuple[float, float, int]:
    epsg = utm_epsg(lat, lon)
    transformer = _transformer(WGS84, f"EPSG:{epsg}")
    x, y = transformer.transform(lon, lat)
    return x, y, epsg


def projected_to_latlon(
    x: float,
    y: float,
    epsg: int,
) -> tuple[float, float]:
    transformer = _transformer(f"EPSG:{epsg}", WGS84)
    lon, lat = transformer.transform(x, y)
    return lat, lon


def latlon_to_web_mercator(
    lat: float,
    lon: float,
) -> tuple[float, float]:
    transformer = _transformer(WGS84, WEB_MERCATOR)
    x, y = transformer.transform(lon, lat)
    return x, y


def web_mercator_to_latlon(
    x: float,
    y: float,
) -> tuple[float, float]:
    transformer = _transformer(WEB_MERCATOR, WGS84)
    lon, lat = transformer.transform(x, y)
    return lat, lon


def page_dimensions_m(
    paper_size: str,
    orientation: str,
    scale: int,
    paper_sizes_mm: dict[str, tuple[float, float]],
) -> tuple[float, float]:
    width_mm, height_mm = paper_sizes_mm[paper_size]

    if orientation == "portrait":
        width_mm, height_mm = height_mm, width_mm

    return (
        width_mm / 1000.0 * scale,
        height_mm / 1000.0 * scale,
    )
```

Important: if a route crosses UTM zones, use one projection for the entire route instead of selecting a separate UTM EPSG code for every point. A practical solution is to select the zone from the route's average longitude.

---

## `bike_map_atlas/gpx_parser.py`

```python
from __future__ import annotations

import math
from pathlib import Path

import gpxpy

from .models import RoutePoint
from .projection import latlon_to_projected


class GPXParser:
    @staticmethod
    def parse(
        file_path: str | Path,
    ) -> tuple[list[RoutePoint], float]:
        path = Path(file_path)

        with path.open("r", encoding="utf-8") as file:
            gpx = gpxpy.parse(file)

        points: list[RoutePoint] = []
        total_m = 0.0

        for track in gpx.tracks:
            for segment in track.segments:
                previous: RoutePoint | None = None

                for gpx_point in segment.points:
                    x, y, zone = latlon_to_projected(
                        gpx_point.latitude,
                        gpx_point.longitude,
                    )

                    current = RoutePoint(
                        lat=gpx_point.latitude,
                        lon=gpx_point.longitude,
                        x=x,
                        y=y,
                        distance_m=total_m,
                        zone=zone,
                    )

                    if previous is not None:
                        total_m += math.hypot(
                            current.x - previous.x,
                            current.y - previous.y,
                        )
                        current.distance_m = total_m

                    points.append(current)
                    previous = current

        if len(points) < 2:
            raise ValueError(
                "The GPX file must contain at least two track points."
            )

        return points, total_m / 1000.0
```

The parser above still merges all track segments. For production use, preserve track and segment boundaries if disconnected routes are possible.

---

## `bike_map_atlas/route_splitter.py`

```python
from __future__ import annotations

from .constants import PAPER_SIZES_MM
from .models import MapSection, RoutePoint
from .projection import page_dimensions_m


class RouteSplitter:
    def __init__(
        self,
        points: list[RoutePoint],
        global_scale: int,
        paper_size: str,
        overlap_m: float = 500.0,
    ) -> None:
        self.points = points
        self.global_scale = global_scale
        self.paper_size = paper_size
        self.overlap_m = max(0.0, overlap_m)

        self.edge_margin = 0.05

    def split(self) -> list[MapSection]:
        if not self.points:
            return []

        sections: list[MapSection] = []
        start_index = 0

        while start_index < len(self.points):
            candidates = [
                self._fit_orientation(start_index, "normal"),
                self._fit_orientation(start_index, "rot90"),
            ]

            best = max(
                candidates,
                key=lambda item: item["score"],
            )

            end_index = best["end_idx"]

            sections.append(
                self._create_section(
                    start_index=start_index,
                    end_index=end_index,
                    index=len(sections),
                    mode=best["mode"],
                )
            )

            if end_index >= len(self.points) - 1:
                break

            end_distance = self.points[end_index].distance_m
            next_distance = max(
                0.0,
                end_distance - self.overlap_m,
            )

            next_index = self._find_index_at_distance(next_distance)

            if next_index <= start_index:
                next_index = start_index + 1

            start_index = next_index

        return sections

    def _available_dimensions(
        self,
        mode: str,
    ) -> tuple[float, float]:
        paper_width_m, paper_height_m = page_dimensions_m(
            self.paper_size,
            "landscape" if mode == "normal" else "portrait",
            self.global_scale,
            PAPER_SIZES_MM,
        )

        return (
            paper_width_m * (1.0 - 2.0 * self.edge_margin),
            paper_height_m * (1.0 - 2.0 * self.edge_margin),
        )

    def _fit_orientation(
        self,
        start_idx: int,
        mode: str,
    ) -> dict:
        available_width, available_height = (
            self._available_dimensions(mode)
        )

        origin = self.points[start_idx]
        min_x = max_x = 0.0
        min_y = max_y = 0.0
        best: dict | None = None

        for end_idx in range(start_idx + 1, len(self.points)):
            point = self.points[end_idx]

            dx = point.x - origin.x
            dy = point.y - origin.y

            if mode == "normal":
                rx, ry = dx, dy
            else:
                rx, ry = dy, -dx

            new_min_x = min(min_x, rx)
            new_max_x = max(max_x, rx)
            new_min_y = min(min_y, ry)
            new_max_y = max(max_y, ry)

            width = new_max_x - new_min_x
            height = new_max_y - new_min_y

            if width > available_width or height > available_height:
                break

            min_x = new_min_x
            max_x = new_max_x
            min_y = new_min_y
            max_y = new_max_y

            coverage = end_idx - start_idx
            area_ratio = (
                max(width, 1.0) * max(height, 1.0)
                / (available_width * available_height)
            )

            score = coverage * (0.3 + 0.7 * area_ratio)

            best = {
                "end_idx": end_idx,
                "mode": mode,
                "score": score,
            }

        if best is None:
            # The next point does not fit. We still advance by one point
            # to prevent an infinite loop.
            return {
                "end_idx": min(start_idx + 1, len(self.points) - 1),
                "mode": mode,
                "score": 0.0,
            }

        return best

    def _create_section(
        self,
        start_idx: int,
        end_idx: int,
        index: int,
        mode: str,
    ) -> MapSection:
        points = self.points[start_idx:end_idx + 1]

        min_x = min(point.x for point in points)
        max_x = max(point.x for point in points)
        min_y = min(point.y for point in points)
        max_y = max(point.y for point in points)

        orientation = (
            "landscape"
            if mode == "normal"
            else "portrait"
        )

        return MapSection(
            index=index,
            points=points,
            start_m=points[0].distance_m,
            end_m=points[-1].distance_m,
            center_xy=(
                (min_x + max_x) / 2.0,
                (min_y + max_y) / 2.0,
            ),
            orientation=orientation,
            paper_size=self.paper_size,
            global_scale=self.global_scale,
        )

    def _find_index_at_distance(self, distance_m: float) -> int:
        low = 0
        high = len(self.points) - 1

        while low <= high:
            middle = (low + high) // 2

            if self.points[middle].distance_m < distance_m:
                low = middle + 1
            else:
                high = middle - 1

        return min(max(low, 0), len(self.points) - 1)
```

This removes the unconditional orientation flip and activates overlap.

---

## `bike_map_atlas/map_renderer.py`

The renderer should use the section's effective zoom:

```python
zoom = section.effective_zoom
```

A simplified corrected version of the relevant method is:

```python
from __future__ import annotations

import time
from pathlib import Path

import contextily as ctx
import matplotlib.pyplot as plt
from matplotlib.backends.backend_pdf import PdfPages
from matplotlib.patches import Rectangle

from .constants import PAPER_SIZES_MM, TILE_PROVIDERS
from .models import MapSection
from .projection import page_dimensions_m


class MapRenderer:
    def __init__(
        self,
        global_scale: int,
        dpi: int = 300,
        tile_source: str | None = None,
    ) -> None:
        self.global_scale = global_scale
        self.dpi = dpi
        self.tile_source = (
            tile_source
            or TILE_PROVIDERS["OpenStreetMap (default)"]
        )

    def render_section(
        self,
        section: MapSection,
        output_path: str | Path,
    ) -> None:
        width_m, height_m = page_dimensions_m(
            section.paper_size,
            section.orientation,
            section.effective_scale,
            PAPER_SIZES_MM,
        )

        width_mm, height_mm = PAPER_SIZES_MM[section.paper_size]

        if section.orientation == "portrait":
            width_mm, height_mm = height_mm, width_mm

        figure = plt.figure(
            figsize=(width_mm / 25.4, height_mm / 25.4),
            dpi=self.dpi,
        )

        axis = figure.add_axes([0, 0, 1, 1])
        axis.set_axis_off()

        center_x, center_y = section.effective_center_xy

        xmin = center_x - width_m / 2.0
        xmax = center_x + width_m / 2.0
        ymin = center_y - height_m / 2.0
        ymax = center_y + height_m / 2.0

        axis.set_xlim(xmin, xmax)
        axis.set_ylim(ymin, ymax)

        zoom = section.effective_zoom

        try:
            ctx.add_basemap(
                axis,
                crs="EPSG:3857",
                source=self.tile_source,
                zoom=zoom,
            )
        except Exception:
            axis.set_facecolor("#e0e0e0")

        axis.plot(
            [point.x for point in section.points],
            [point.y for point in section.points],
            color="red",
            linewidth=0.5,
            alpha=0.7,
            zorder=5,
        )

        figure.savefig(
            output_path,
            format="pdf",
            dpi=self.dpi,
            bbox_inches=None,
            pad_inches=0,
        )

        plt.close(figure)

    def render_overview(
        self,
        sections: list[MapSection],
        total_km: float,
        output_path: str | Path,
    ) -> None:
        if not sections:
            return

        points = [
            point
            for section in sections
            for point in section.points
        ]

        xs = [point.x for point in points]
        ys = [point.y for point in points]

        x_padding = max((max(xs) - min(xs)) * 0.1, 100.0)
        y_padding = max((max(ys) - min(ys)) * 0.1, 100.0)

        figure, axis = plt.subplots(
            figsize=(16.5, 11.7),
            dpi=self.dpi,
        )

        axis.set_xlim(
            min(xs) - x_padding,
            max(xs) + x_padding,
        )
        axis.set_ylim(
            min(ys) - y_padding,
            max(ys) + y_padding,
        )
        axis.set_aspect("equal")

        try:
            ctx.add_basemap(
                axis,
                crs="EPSG:3857",
                source=self.tile_source,
                zoom="auto",
            )
        except Exception:
            axis.set_facecolor("#e0e0e0")

        axis.plot(
            xs,
            ys,
            color="red",
            linewidth=1.0,
        )

        for section in sections:
            width_m, height_m = page_dimensions_m(
                section.paper_size,
                section.orientation,
                section.effective_scale,
                PAPER_SIZES_MM,
            )

            center_x, center_y = section.effective_center_xy

            rectangle = Rectangle(
                (
                    center_x - width_m / 2.0,
                    center_y - height_m / 2.0,
                ),
                width_m,
                height_m,
                fill=False,
                edgecolor="blue",
                linewidth=1.5,
                linestyle="--",
            )

            axis.add_patch(rectangle)
            axis.text(
                center_x,
                center_y,
                str(section.index + 1),
                ha="center",
                va="center",
                bbox={
                    "boxstyle": "circle",
                    "facecolor": "white",
                    "alpha": 0.7,
                },
            )

        axis.set_axis_off()

        with PdfPages(output_path) as pdf:
            pdf.savefig(figure)

        plt.close(figure)
```

This renderer assumes that `RoutePoint.x` and `RoutePoint.y` are in EPSG:3857. The parser and projection layer must therefore be aligned with this choice.

